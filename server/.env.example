# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/redvendedora
# Clave para firmar las sesiones: poné una larga y secreta
JWT_SECRET=cambiar-por-una-clave-larga
PORT=3001
# Dirección pública de la app (se usa en los links de pago de los WhatsApp)
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Admin inicial (npm run seed)
ADMIN_PHONE=1100000000
ADMIN_PASSWORD=admin123

# WhatsApp: 'simulated' guarda los mensajes sin enviarlos; 'meta' usa la API oficial
WHATSAPP_PROVIDER=simulated
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=es_AR

# Mercado Pago (opcional): token de acceso de producción o de prueba
MP_ACCESS_TOKEN=

# Proceso diario automático (off para desactivarlo y usar `npm run daily` con cron)
DAILY_JOB=on
# Carpeta de fotos de productos (por defecto server/uploads; en producción usá un disco persistente)
UPLOADS_DIR=
